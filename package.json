{
  "name": "cortex-notes-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts dev",
    "parse": "bun run src/cli.ts parse",
    "index": "bun run src/cli.ts index",
    "vault:init": "bun run src/cli.ts vault:init",
    "vault:check": "bun run src/cli.ts vault:check",
    "migrate": "bun run src/cli.ts migrate",
    "mcp": "bun run src/cli.ts mcp",
    "benchmark": "bun run bench/run.ts",
    "git:status": "bun run src/cli.ts git:status",
    "git:history": "bun run src/cli.ts git:history",
    "git:diff": "bun run src/cli.ts git:diff",
    "git:restore": "bun run src/cli.ts git:restore",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "@parcel/watcher": "^2.5.1",
    "remark-frontmatter": "^5.0.0",
