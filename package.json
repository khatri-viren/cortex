{
  "name": "cortex-notes-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts dev",
    "dev:all": "bun run scripts/dev-all.ts",
    "parse": "bun run src/cli.ts parse",
    "index": "bun run src/cli.ts index",
    "vault:init": "bun run src/cli.ts vault:init",
    "vault:check": "bun run src/cli.ts vault:check",
    "migrate": "bun run src/cli.ts migrate",
    "mcp": "bun run src/cli.ts mcp",
    "ui:dev": "cd ui && bun run dev",
    "ui:build": "cd ui && bun run build",
    "desktop:dev": "cd ui && bunx tauri dev",
    "desktop:chromium": "bun run scripts/prepare-chromium.ts",
    "desktop:sidecar": "bun run scripts/build-sidecar.ts",
    "desktop:build": "cd ui && bun run desktop:build",
    "desktop:verify": "bun run scripts/verify-bundle.ts",
    "desktop:smoke": "bun run scripts/packaged-smoke.ts",
    "desktop:update:manifest": "bun run scripts/build-update-manifest.ts",
    "ui:preview": "cd ui && bun run preview",
    "e2e": "cd ui && bun run e2e",
    "benchmark": "bun run bench/run.ts",
    "benchmark:desktop": "bun run bench/desktop-baseline.ts",
    "benchmark:pdf-renderer": "bun run scripts/pdf-renderer-report.ts",
    "desktop:native-baseline": "bun run scripts/native-desktop-baseline.ts",
    "benchmark:e2e": "bun run bench/e2e/run.ts",
    "benchmark:e2e:aggregate": "bun run bench/e2e/aggregate.ts",
    "git:status": "bun run src/cli.ts git:status",
    "git:history": "bun run src/cli.ts git:history",
    "git:diff": "bun run src/cli.ts git:diff",
    "git:restore": "bun run src/cli.ts git:restore",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "@parcel/watcher": "^2.5.1",
    "chromium-bidi": "^0.8.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "1.61.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.8.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
