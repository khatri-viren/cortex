{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-list-vaults",
    "allow-add-vault-via-dialog",
    "allow-remove-vault",
    "allow-reveal-vault",
    "allow-open-vault",
    "allow-get-preferences",
    "allow-load-session",
    "allow-save-session",
    "allow-set-preferences",
    "allow-close-main-window",
    "allow-save-pdf"
  ]
}
