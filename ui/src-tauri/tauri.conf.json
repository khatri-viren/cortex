{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cortex",
  "version": "0.1.0",
  "identifier": "dev.cortex.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "bun run build && bun run desktop:sidecar && bun run ../scripts/prepare-chromium.ts",
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cortex",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        },
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cortex-sidecar"],
    "resources": {
      "../dist": "dist",
      "../../resources/chromium": "chromium"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
